# ==============================================================================
# Backend Dockerfile - Appota NextGen Enterprise Secure RAG (FastAPI)
# ==============================================================================
FROM python:3.12-slim

WORKDIR /app

# Tối ưu hóa môi trường Python và giới hạn thread pools tiết kiệm RAM
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

# Cài đặt các thư viện phụ thuộc Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Sao chép mã nguồn và cơ sở dữ liệu vector
COPY src/ ./src/
COPY data/ ./data/
COPY qdrant_db/ ./qdrant_db/
COPY app.py main.py reingest.py users.json ./

# Mở cổng API
EXPOSE 8000

# Khởi chạy FastAPI Server bằng Uvicorn
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
