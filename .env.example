# ==============================================================================
# Biến môi trường hệ thống Appota NextGen Enterprise Secure RAG
# ==============================================================================

# 1. Google Gemini API Key (BẮT BUỘC)
# Tạo API Key miễn phí tại: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Cấu hình Model AI (Tùy chọn - Đã có giá trị mặc định tối ưu)
LLM_MODEL="gemini-3.5-flash-lite"
EMBEDDING_MODEL="text-embedding-004"

# 3. Cấu hình Advanced RAG (Tùy chọn)
ENABLE_HYBRID="true"
ENABLE_RERANK="true"
SIMILARITY_TOP_K="5"
RETRIEVAL_TOP_K="15"
RERANK_TOP_K="5"